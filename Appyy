@app.route('/api/send-patient-gmail', methods=['POST'])
def save_history_to_patient_gmail():
    """2nd History Save in Patient Gmail API"""
    data = request.json
    patient_email = data.get('email')
    consultation_history = data.get('history')

    # Configure your SMTP credentials (or environment variables)
    SMTP_SERVER = "smtp.gmail.com"
    SMTP_PORT = 587
    SENDER_EMAIL = "your_email@gmail.com"
    SENDER_PASSWORD = "your_app_password"

    try:
        msg = MIMEMultipart()
        msg['From'] = SENDER_EMAIL
        msg['To'] = patient_email
        msg['Subject'] = "Your Dental Consultation History & Treatment Record"

        msg.attach(MIMEText(consultation_history, 'plain'))

        server = smtplib.SMTP(SMTP_SERVER, SMTP_PORT)
        server.starttls()
        server.login(SENDER_EMAIL, SENDER_PASSWORD)
        server.sendmail(SENDER_EMAIL, patient_email, msg.as_string())
        server.quit()

        return jsonify({"status": "success", "message": f"History successfully sent to patient email: {patient_email}"})
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)}), 500


@app.route('/api/kuhs-papers', methods=['GET'])
def get_kuhs_papers():
    """3rd Previous Year Question Paper KUHS University API"""
    subject = request.args.get('subject')
    if subject and subject in KUHS_PAPERS_DB:
        return jsonify({subject: KUHS_PAPERS_DB[subject]})
    return jsonify(KUHS_PAPERS_DB)


@app.route('/api/export-result', methods=['POST'])
def export_result_report():
    """4th Result Save as PDF or HTML & Print Option API"""
    data = request.json
    html_content = data.get('html_content', '<h3>Diagnostic Report</h3><p>No details found.</p>')
    
    # Save content as an HTML file format ready for browser print/save-as-PDF
    file_path = os.path.join(app.config['UPLOAD_FOLDER'], 'Patient_Diagnostic_Result.html')
    with open(file_path, 'w', encoding='utf-8') as f:
        f.write(html_content)
        
    return send_file(file_path, as_attachment=True, download_name='Patient_Diagnostic_Result.html')


@app.route('/api/upload-soft-tissue', methods=['POST'])
def upload_soft_tissue():
    """5th Soft Tissue Upload Option API"""
    if 'file' not in request.files:
        return jsonify({"status": "error", "message": "No file section found"}), 400
    
    file = request.files['file']
    if file.filename == '':
        return jsonify({"status": "error", "message": "No file selected"}), 400
        
    if file:
        file_path = os.path.join(app.config['UPLOAD_FOLDER'], file.filename)
        file.save(file_path)
        return jsonify({"status": "success", "message": f"Soft tissue file '{file.filename}' uploaded securely!"})


